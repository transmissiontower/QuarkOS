# Makefile.doom - Build DOOM for QuarkOS (aarch64)
# Invoke: make -f Makefile.doom

CROSS ?= aarch64-elf-
CC      = $(CROSS)gcc
LD      = $(CROSS)ld
OBJCOPY = $(CROSS)objcopy

DOOM_DIR    = src/user/doom/doomgeneric
DOOM_INC    = src/user/doom/include
BUILD_DIR   = build_aarch64_user/doom
LIBGCC      = $(shell $(CC) -mcpu=cortex-a57 -print-libgcc-file-name)

# QuarkOS user library objects (only crt0 + libapi, no lib.o/stdio.o)
QK_USER_DIR = build_aarch64_user
QK_OBJS     = $(QK_USER_DIR)/crt0.o $(QK_USER_DIR)/libapi.o

CFLAGS = -ffreestanding -Wall -O2 -mcpu=cortex-a57 -mstrict-align \
         -fno-stack-protector -Wno-unused-parameter -Wno-sign-compare \
         -Wno-missing-field-initializers \
         -I$(DOOM_INC) -I$(DOOM_DIR) \
         -DQUARKOS -D_DEFAULT_SOURCE

LDFLAGS = -T src/user/linker_aarch64.ld -nostdlib

# DOOM engine sources (matches doomgeneric soso build)
DOOM_SRC = \
    dummy.c am_map.c doomdef.c doomstat.c dstrings.c \
    d_event.c d_items.c d_iwad.c d_loop.c d_main.c d_mode.c d_net.c \
    f_finale.c f_wipe.c g_game.c \
    hu_lib.c hu_stuff.c info.c \
    i_cdmus.c i_endoom.c i_joystick.c i_scale.c i_sound.c i_system.c i_timer.c \
    memio.c m_argv.c m_bbox.c m_cheat.c m_config.c m_controls.c m_fixed.c \
    m_menu.c m_misc.c m_random.c \
    p_ceilng.c p_doors.c p_enemy.c p_floor.c p_inter.c p_lights.c \
    p_map.c p_maputl.c p_mobj.c p_plats.c p_pspr.c p_saveg.c \
    p_setup.c p_sight.c p_spec.c p_switch.c p_telept.c p_tick.c p_user.c \
    r_bsp.c r_data.c r_draw.c r_main.c r_plane.c r_segs.c r_sky.c r_things.c \
    sha1.c sounds.c statdump.c st_lib.c st_stuff.c s_sound.c \
    tables.c v_video.c wi_stuff.c \
    w_checksum.c w_file.c w_main.c w_wad.c w_file_stdc.c \
    i_input.c i_video.c \
    z_zone.c doomgeneric.c \
    doomgeneric_quarkos.c quarkos_stubs.c

DOOM_OBJ = $(addprefix $(BUILD_DIR)/, $(DOOM_SRC:.c=.o))

all: Asm/boot/doom.qex

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/%.o: $(DOOM_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

Asm/boot/doom.qex: $(DOOM_OBJ) $(QK_OBJS)
	mkdir -p Asm/boot
	$(LD) $(LDFLAGS) -o $(BUILD_DIR)/doom.elf $(QK_OBJS) $(DOOM_OBJ) $(LIBGCC)
	$(OBJCOPY) -O binary $(BUILD_DIR)/doom.elf $(BUILD_DIR)/doom.bin
	python3 tools/qex_builder.py $(BUILD_DIR)/doom.bin Asm/boot/doom.qex

clean:
	rm -rf $(BUILD_DIR)
	rm -f Asm/boot/doom.qex

.PHONY: all clean
